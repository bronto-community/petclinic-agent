# Shared secret the agent sends in X-PetClinic-Key
PETCLINIC_API_KEY=change-me
# Any OTLP/HTTP backend (traces, metrics and logs from the OpenTelemetry Java agent)
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp.example.com
OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer%20<token>
# Set to true to run without exporting telemetry
OTEL_SDK_DISABLED=false
# Locally ":8080"; on AWS the public hostname, e.g. petclinic.example.com
SITE_ADDRESS=:8080
ENVIRONMENT=local
