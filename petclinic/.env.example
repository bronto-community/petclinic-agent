# Shared secret the agent sends in X-PetClinic-Key
PETCLINIC_API_KEY=change-me
# OTLP/HTTP backend the OpenTelemetry Collector exports to (traces, metrics, logs)
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp.example.com
# Headers for that backend, as a YAML map; values are sent as written (no URL encoding)
OTLP_HEADERS={authorization: "Bearer <token>"}
# Set to true to stop PetClinic's Java agent from producing telemetry
OTEL_SDK_DISABLED=false
# Locally ":8080"; on a server the public hostname, e.g. petclinic.example.com
SITE_ADDRESS=:8080
ENVIRONMENT=local
